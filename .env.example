# MongoDB connection string (MongoDB Atlas recommended - free tier works)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bushubbd?retryWrites=true&w=majority

# Public base URL of the deployed site, used in ticket and WhatsApp links (defaults to https://www.bushubbd.com)
NEXT_PUBLIC_BASE_URL=https://www.bushubbd.com

# Secret used to sign admin/company login sessions - set to any long random string
JWT_SECRET=change-this-to-a-long-random-string

# Platform owner (admin) login - set these to your own credentials
ADMIN_EMAIL=admin@bushubbd.com
ADMIN_PASSWORD=change-this-password

# WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose - enter the same value when setting up the webhook in Meta's dashboard
WHATSAPP_VERIFY_TOKEN=bushub-verify-token
# Meta app → Settings → Basic → App secret. When set, only messages signed by Meta reach the bot.
WHATSAPP_APP_SECRET=

# Optional: the approved WhatsApp message template used to send tickets (Meta only lets a business
# start a chat with an approved template). Its body takes 5 values in this order:
# {{1}} passenger name, {{2}} route, {{3}} date and time, {{4}} seats, {{5}} ticket link.
WHATSAPP_TICKET_TEMPLATE=

# Email for sending tickets (resend.com). Verify your domain in Resend, then set both.
RESEND_API_KEY=
EMAIL_FROM=BusHub <tickets@bushubbd.com>

# Marketing measurement (optional). Google Analytics 4 measurement ID (starts with G-) and the
# Facebook/Meta Pixel ID (numbers only). Leave empty to load neither. Vercel Analytics needs no
# key: switch it on in the Vercel project under Analytics.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Online ticket sales on the website. Leave unset (paused) until a payment gateway confirms payments.
# NEXT_PUBLIC_ONLINE_SALES=on
